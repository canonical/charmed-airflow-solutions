set export := true

# Default: show all recipes
default:
    @just --list

# Clean tfvars file
[private]
clean_tfvars variables_file:
    #!/usr/bin/bash
    set -euxo pipefail
    if [ -f "${variables_file}" ]; then
        sed -i '/^model_uuid[[:space:]]*=/d' "${variables_file}"
    fi

# Initialize terraform
[private]
initialize:
    #!/usr/bin/bash
    if [ ! -d ".terraform" ]; then
        terraform init -backend=false
    fi

# Destroy model if exists
[private]
destroy-model:
    juju destroy-model --no-prompt --destroy-storage airflow-test --force || true

# Add a fresh model
add-model: (destroy-model)
    juju add-model airflow-test

# Validate and create tfvars file
validate_test_tfvars variables_file: (clean_tfvars variables_file)
    #!/usr/bin/bash

    set -euxo pipefail
    MODEL_UUID=$(juju show-model airflow-test --format=json | jq -r '."airflow-test"["model-uuid"]')
    if ! juju show-model "${MODEL_UUID}" >/dev/null 2>&1; then
        exit 1
    fi
    echo "model_uuid = \"${MODEL_UUID}\"" >> "${variables_file}"

# Terraform fmt
fmt: (initialize)
    terraform fmt -recursive

# Terraform validate
validate: (initialize)
    terraform validate

# Lint
lint:
    tflint

# Run kgoss checks
kgoss-checks:
    #!/usr/bin/bash
    set -euxo pipefail
    
    env GOSS_FILES_PATH="test" \
    GOSS_OPTS="--color" \
    GOSS_WAIT_OPTS="-r 480s -s 2s" \
    GOSS_KUBECTL_OPTS="--namespace=airflow-test" \
    kgoss run -i ubuntu/airflow:3.1-24.04_edge -p

# Run airflow pod and attach shell in interactive mode
kgoss-checks-run:
    #!/usr/bin/bash
    set -euxo pipefail
    
    env GOSS_FILES_PATH="test" \
    GOSS_OPTS="--color" \
    GOSS_WAIT_OPTS="-r 480s -s 2s" \
    GOSS_KUBECTL_OPTS="--namespace=airflow-test" \
    kgoss edit -i ubuntu/airflow:3.1-24.04_edge -p

# Apply with variables file
apply variables_file: (initialize)
    terraform apply -auto-approve -var-file="${variables_file}"

# Destroy terraform and model with variables file
destroy variables_file:
    #!/usr/bin/bash
    set -euxo pipefail
    if [ ! -f "${variables_file}" ]; then
        exit 1
    fi
    terraform destroy -auto-approve -var-file="${variables_file}" || true
    just destroy-model
    just clean_tfvars "${variables_file}"

# Apply with a base variables file and an overlay variables file
apply-with-overlay base_file overlay_file: (initialize)
    terraform apply -auto-approve -var-file="${base_file}" -var-file="${overlay_file}"

# Destroy with a base and an overlay variables file
destroy-with-overlay base_file overlay_file:
    #!/usr/bin/bash
    set -euxo pipefail
    terraform destroy -auto-approve -var-file="${base_file}" -var-file="${overlay_file}" || true
    just destroy-model
    just clean_tfvars "${base_file}"

# Port-forward otel-collector and run goss COS tests
[private]
goss-cos:
    #!/usr/bin/bash
    set -euxo pipefail
    kubectl port-forward -n airflow-test pod/otel-collector-0 13133:13133 8888:8888 &
    PF_PID=$!
    trap 'kill ${PF_PID} 2>/dev/null || true' EXIT
    GOSS_FILE=test/goss-cos.yaml goss validate --retry-timeout 30s

# Wait for all applications in airflow-test to reach active status.
# Pass application names as positional args to exclude them from the active check
# (e.g. otel-collector, which is expected to stay blocked until the consumer wires their COS).
wait-for-active *excluded:
    #!/usr/bin/env bash
    set -euxo pipefail

    query='forEach(applications, app => app.status == "active")'
    if [ -n "{{ excluded }}" ]; then
        clause=""
        for app in {{ excluded }}; do
            clause="${clause:+$clause || }app.name == \"$app\""
        done
        query="forEach(applications, app => ($clause) || app.status == \"active\")"
    fi

    timeout=1200
    elapsed=0
    interval=10
    while [ $elapsed -lt $timeout ]; do
        # Run the command on intervals to make sure juju sees the actual state of the model
        # Sometimes it gets stuck at waiting even if applications in the model are active
        # if we just call it directly. This is likely a bug on juju's end.
        if juju wait-for model airflow-test \
            --query="$query" \
            --timeout=${interval}s 2>/dev/null; then
            exit 0
        fi
        elapsed=$((elapsed + interval))
    done
    echo "Timed out waiting for applications (excluding: {{ excluded }}) to become active"
    exit 1

# Create a Kubernetes namespace if it doesn't exist
[private]
create-namespace ns:
    #!/usr/bin/bash
    set -euxo pipefail
    command -v kubectl >/dev/null 2>&1 || { echo "kubectl not found"; exit 1; }
    # Ensure idempotency
    kubectl create namespace "{{ ns }}" --dry-run=client -o yaml | kubectl apply -f -

# Create and grant the fernet-key secret to airflow-coordinator
[private]
configure-fernet-key:
    #!/usr/bin/bash
    set -euo pipefail
    SECRET_URI=$(juju add-secret -m airflow-test fernet-key-secret "fernet-key=$(openssl rand -base64 32 | tr '+/' '-_')")
    juju grant-secret -m airflow-test fernet-key-secret airflow-coordinator
    juju config -m airflow-test airflow-coordinator fernet_key_secret="${SECRET_URI}"

# Generic test (create model, apply, wait, kgoss checks, cleanup)
[private]
_test tfvars:
    #!/usr/bin/bash
    set -euxo pipefail

    trap 'just destroy "{{ tfvars }}"' EXIT

    just add-model

    rm -f terraform.tfstate terraform.tfstate.backup

    just validate_test_tfvars "{{ tfvars }}"

    just apply "{{ tfvars }}"

    just configure-fernet-key

    just wait-for-active

    just kgoss-checks

# Full test with local executor (default)
test: (_test "test/terraform_test_local_executor.tfvars")

# Full test with kubernetes executor
test-k8s-executor: (create-namespace "airflow-executor-workers") (_test "test/terraform_test_kubernetes_executor.tfvars")

# Full test for COS with module-deployed opentelemetry-collector-k8s
test-cos:
    #!/usr/bin/bash
    set -euxo pipefail

    trap 'just destroy-with-overlay "test/terraform_test_local_executor.tfvars" "test/terraform_cos.tfvars"' EXIT

    just add-model

    rm -f terraform.tfstate terraform.tfstate.backup

    just validate_test_tfvars "test/terraform_test_local_executor.tfvars"

    just apply-with-overlay "test/terraform_test_local_executor.tfvars" "test/terraform_cos.tfvars"

    # otel-collector is expected to end up blocked on the mandatory-relation pair check
    # when `receive-otlp` has peers but no outgoing sink (`send-remote-write`, `send-loki-logs`,
    # `send-otlp`, `send-traces`, or `cloud-config`) is wired. The sink is the consumer's
    # responsibility, so we exclude otel-collector from wait-for-active and validate its
    # workload health via goss-cos.
    just wait-for-active otel-collector
    juju wait-for unit otel-collector/0 --model airflow-test \
        --query='workload-status=="blocked"' \
        --timeout=300s

    just kgoss-checks
    just goss-cos

# Full test for COS with a pre-deployed opentelemetry-collector-k8s
test-cos-existing:
    #!/usr/bin/bash
    set -euxo pipefail

    trap 'just destroy-with-overlay "test/terraform_test_local_executor.tfvars" "test/terraform_cos_existing.tfvars"' EXIT

    just add-model

    rm -f terraform.tfstate terraform.tfstate.backup

    just validate_test_tfvars "test/terraform_test_local_executor.tfvars"

    juju deploy opentelemetry-collector-k8s otel-collector --channel=0.130/stable --trust -m airflow-test
    juju wait-for application otel-collector --model airflow-test \
        --query='status=="active"' --timeout=300s

    just apply-with-overlay "test/terraform_test_local_executor.tfvars" "test/terraform_cos_existing.tfvars"

    just wait-for-active otel-collector
    juju wait-for unit otel-collector/0 --model airflow-test \
        --query='workload-status=="blocked"' \
        --timeout=300s

    just kgoss-checks
    just goss-cos

